@using WhistTournaments.Models.Tournaments
@model TournamentDetailDto

<h1>WiP</h1>

<form asp-controller="Tournament" asp-action="UpdateTournament" asp-route-id="@Model.Id" method="post">
    <div>
        <label asp-for="Name">@Html.DisplayNameFor(m => Model.Name)</label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="Type">@Html.DisplayNameFor(m => Model.Type)</label>
        <select asp-for="Type">
            <option>Yes</option>
            <option>No</option>
        </select>
    </div>
    <div>
        <label asp-for="RegEndDate">@Html.DisplayNameFor(m => Model.RegEndDate)</label>
        <input asp-for="RegEndDate" type="date" value="@Html.DisplayFor(m=>Model.RegEndDate)" />
    </div>
    <div>
        <label asp-for="StartDate">@Html.DisplayNameFor(m => Model.StartDate)</label>
        <input asp-for="StartDate" type="date" />
    </div>
    <div>
        <label asp-for="NbPlayers"></label>
        <select asp-for="NbPlayers">
            <option value="4">4</option>
            <option value="8">8</option>
            <option value="16">16</option>
        </select>
    </div>
    <div>
        <label asp-for="NbSubscribedPlayers">@Html.DisplayNameFor(m => Model.NbSubscribedPlayers)</label>
        <input asp-for="NbSubscribedPlayers" type="number" value="@Html.DisplayFor(m => Model.NbSubscribedPlayers)" />
    </div>
    <button type="submit">Update tournament</button>
</form>
