@using WhistTournaments.Extensions
@using WhistTournaments.Models.Tournaments
@using WhistTournaments.DL.Enums
@model IEnumerable<WhistTournaments.Models.Tournaments.TournamentIndexDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (TempData["FullTournamentError"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["FullTournamentError"]
    </div>
}

@if (TempData["AlreadySubscribedError"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["AlreadySubscribedError"]
    </div>
}

@if (TempData["NotSubscribedError"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["NotSubscribedError"]
    </div>
}

@if(User.IsAdmin())
{
<p>
    <a asp-controller="Tournament" asp-action="CreateTournament">Create New</a>
</p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbSubscribedPlayers)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbPlayers)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbMatchs)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Step)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbSubscribedPlayers)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbPlayers)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbMatchs)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Step)
            </td>

            <td>
                <div class="btn-group" role="group">
                    <a class="btn btn-warning" asp-controller="Tournament" asp-action="Details" asp-route-id="@item.Id">Détails</a>
                    @if (User.IsAdmin() && !item.OnGoing)
                    {
                        <a class="btn btn-danger" asp-controller="Tournament" asp-action="Update" asp-route-id="@item.Id">Update</a>
                    }
                    @if (item.NbSubscribedPlayers == item.NbPlayers && User.IsAdmin() && !item.OnGoing)
                    {
                        <a class="btn btn-success" asp-controller="Tournament" asp-action="InitiateTournament" asp-route-id="@item.Id">Initiate</a>
                    }
                    @if (User.IsAdmin() && (item.Step == Step.Tour1 || item.Step == Step.DemiFinale || item.Step == Step.Finale))
                    {
                        <a class="btn btn-success" asp-controller="Tournament" asp-action="WriteResults" asp-route-id="@item.Id">Encoder Tour 1</a>
                    }
                    @if (item.NbSubscribedPlayers < item.NbPlayers && User.IsConnected() && !item.IsUserSubscribed && !item.OnGoing)
                    {
                        <a class="btn btn-success" asp-controller="Tournament" asp-action="Subscribe" asp-route-id="@item.Id">S'inscrire</a>
                    }
                    @if (item.IsUserSubscribed && !item.OnGoing)
                    {
                        <button class="btn btn-secondary btn-sm" disabled>Déjà inscrit</button>
                         <a class="btn btn-sm btn-primary" asp-controller="Tournament" asp-action="Unsubscribe" asp-route-id="@item.Id">Se désinscrire</a>
                    }

                </div>
            </td>

        </tr>
}
    </tbody>
</table>
