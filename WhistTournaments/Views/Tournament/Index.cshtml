@using WhistTournaments.Extensions
@model IEnumerable<WhistTournaments.Models.Tournaments.TournamentIndexDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if(User.IsAdmin())
{
<p>
    <a asp-controller="Tournament" asp-action="CreateTournament">Create New</a>
</p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbSubscribedPlayers)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbPlayers)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbMatchs)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OnGoing)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbSubscribedPlayers)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbPlayers)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NbMatchs)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OnGoing)
            </td>
            <td>
                
                    <a class="btn btn-warning"
                       asp-controller="Tournament"
                       asp-action="Details"
                       asp-route-id="@item.Id">
                        Détails
                    </a>
                    @if (item.NbSubscribedPlayers < item.NbPlayers && User.IsConnected())
                    {
                        <a class="btn btn-sm btn-primary"
                        asp-controller="Tournament"
                        asp-action="Subscribe"
                        asp-route-id="@item.Id">
                            S'inscrire
                        </a>
                    }

                    @if(User.IsAdmin())
                    {
                    <a class="btn btn-danger"
                        asp-controller="Tournament"
                        asp-action="Update"
                        asp-route-id="@item.Id">
                        Update
                    </a>
                    }
                
            </td>
        </tr>
}
    </tbody>
</table>
