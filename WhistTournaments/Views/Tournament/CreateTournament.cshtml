@using WhistTournaments.Models.Tournaments
@model TournamentDetailDto

<h1>WiP</h1>

<form asp-controller="Tournament" asp-action="CreateTournament" method="post">
    <div>
        <label asp-for="Name">@Html.DisplayName(Model.Name)</label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="Type">@Html.DisplayNameFor(m => Model.Type)</label>
        <select asp-for="Type">
            <option>Yes</option>
            <option>No</option>
        </select>
    </div>
    <div>
        <label asp-for="RegEndDate">@Html.DisplayNameFor(m => Model.RegEndDate)</label>
        <input asp-for="RegEndDate" type="datetime-local" />
    </div>
    <div>
        <label asp-for="StartDate">@Html.DisplayNameFor(m => Model.StartDate)</label>
        <input asp-for="StartDate" type="datetime-local" />
    </div>
    <div>
        <label asp-for="NbPlayers"></label>
        <select asp-for="NbPlayers">
            <option value="4">4</option>
            <option value="8">8</option>
            <option value="16">16</option>
        </select>
    </div>
    <button type="submit">Create new tournament</button>
</form>