@using WhistTournaments.Models.Tournaments
@model TournamentDetailDto

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Tournament</h4>
    <hr />
    <dl class="row">

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Type)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RegEndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegEndDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbSubscribedPlayers)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbSubscribedPlayers)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbPlayers)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbPlayers)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbMatchs)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbMatchs)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OnGoing)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OnGoing)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index"
    >Back to List</a>
</div>

<div class="container my-5">
    <h2 class="text-center mb-4">Tournoi Whist - 16 Joueurs</h2>
    <div class="bracket">

        <!-- Arbre gauche -->
        <div class="side left">
            <!-- Tour 1 -->
            <div class="column round1">
                <div class="match">
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.ScorePlayer1)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.ScorePlayer2)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.ScorePlayer3)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 7)?.ScorePlayer4)
                </div>

                <div class="match">
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.ScorePlayer1)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.ScorePlayer2)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.ScorePlayer3)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 6)?.ScorePlayer4)
                </div>
            </div>
            <!-- Tour 2 -->
            <div class="column round2" id="DF1">
                <div class="match">
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.ScorePlayer1)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.ScorePlayer2)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.ScorePlayer3)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 3)?.ScorePlayer4)
                </div>
            </div>
        </div>

        <!-- Finale -->
        <div class="finale">
            <div class="match final">
                @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.ScorePlayer1)<br>
                @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.ScorePlayer2)<br>
                @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.ScorePlayer3)<br>
                @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 1)?.ScorePlayer4)
            </div>
        </div>

        <!-- Arbre droit inversé -->
        <div class="side right">

            <!-- Tour 2 -->
            <div class="column round2" id="DF2">
                <div class="match">
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.ScorePlayer1)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.ScorePlayer2)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.ScorePlayer3)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 2)?.ScorePlayer4)
                </div>
            </div>
            <!-- Tour 1 -->
            <div class="column round1">
                <div class="match">
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.ScorePlayer1)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.ScorePlayer2)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.ScorePlayer3)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 5)?.ScorePlayer4)
                </div>
                <div class="match">
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.Player1) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.ScorePlayer1)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.Player2) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.ScorePlayer2)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.Player3) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.ScorePlayer3)<br>
                    @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.Player4) : @(Model.gameDtos.FirstOrDefault(g => g.Step == 4)?.ScorePlayer4)
                </div>
            </div>
        </div>

    </div>
</div>