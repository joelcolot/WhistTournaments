@using WhistTournaments.Models.Tournaments
@model TournamentDetailDto

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<div>
    <h4>Tournament</h4>
    <hr />
    <dl class="row">

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Type)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RegEndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegEndDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbSubscribedPlayers)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbSubscribedPlayers)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbPlayers)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbPlayers)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbMatchs)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbMatchs)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OnGoing)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OnGoing)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index"
    >Back to List</a>
</div>

<div class="container my-5">
    <h2 class="text-center mb-4">Tournoi Whist - 32 Joueurs</h2>
    <div class="bracket">

        <!-- Arbre gauche -->
        <div class="side left">
            <div class="column round1">
                <div class="match" id="L1">@(Model.gameDtos.FirstOrDefault(g => g.Step == 15)?.Player1)<br>J2<br>J3<br>J4</div>
                <div class="match" id="L2">J5<br>J6<br>J7<br>J8</div>
                <div class="match" id="L3">J9<br>J10<br>J11<br>J12</div>
                <div class="match" id="L4">J13<br>J14<br>J15<br>J16</div>
            </div>
            <div class="column round2">
                <div class="match" id="L5">Top2 L1<br>Top2 L2<br>-<br>-</div>
                <div class="match" id="L6">Top2 L3<br>Top2 L4<br>-<br>-</div>
            </div>
            <div class="column round3">
                <div class="match" id="L7">Top2 L5<br>Top2 L6<br>-<br>-</div>
            </div>
        </div>

        <!-- Finale -->
        <div class="finale">
            <div class="match final" id="F">Finaliste A<br>Finaliste B<br>Finaliste C<br>Finaliste D</div>
        </div>

        <!-- Arbre droit inversé -->
        <div class="side right">
            <div class="column round3">
                <div class="match" id="R7">Top2 R5<br>Top2 R6<br>-<br>-</div>
            </div>
            <div class="column round2">
                <div class="match" id="R5">Top2 R1<br>Top2 R2<br>-<br>-</div>
                <div class="match" id="R6">Top2 R3<br>Top2 R4<br>-<br>-</div>
            </div>

            <div class="column round1">
                <div class="match" id="R1">J17<br>J18<br>J19<br>J20</div>
                <div class="match" id="R2">J21<br>J22<br>J23<br>J24</div>
                <div class="match" id="R3">J25<br>J26<br>J27<br>J28</div>
                <div class="match" id="R4">J29<br>J30<br>J31<br>J32</div>
            </div>
        </div>

    </div>
</div>

