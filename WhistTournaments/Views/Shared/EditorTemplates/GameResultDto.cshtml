@using WhistTournaments.Models.Games;

@model GameResultDto

<div class="card p-3 mb-3">


    <div class="form-group">
        <label asp-for="Score1">@Model.Player1</label>
        <input asp-for="Score1" class="form-control" type="number" min="0" />
        <span asp-validation-for="Score1" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Score2">@Model.Player2</label>
        <input asp-for="Score2" class="form-control" type="number" min="0" />
        <span asp-validation-for="Score2" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Score3">@Model.Player3</label>
        <input asp-for="Score3" class="form-control" type="number" min="0" />
        <span asp-validation-for="Score3" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Score4">@Model.Player4</label>
        <input asp-for="Score4" class="form-control" type="number" min="0" />
        <span asp-validation-for="Score4" class="text-danger"></span>
    </div>
</div>
